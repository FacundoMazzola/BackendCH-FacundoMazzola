<h1>📱 Tienda de Celulares</h1>

<div style="display:grid;grid-template-columns:repeat(2,1fr);gap:20px">
    {{#each products}}
    <div style="border:1px solid #ccc;padding:10px">
        <img src="{{this.thumbnails.[0]}}" width="200" />
        <h3>{{this.title}}</h3>
        <p>${{this.price}}</p>
        <button onclick="addToCart('{{this._id}}')">
            🛒 Agregar al carrito
        </button>
    </div>
    {{/each}}
</div>

<div style="margin-top:20px">
    {{#if hasPrevPage}}
    <a href="/products?page={{prevPage}}">⬅ Anterior</a>
    {{/if}}

    <strong>Página {{page}}</strong>

    {{#if hasNextPage}}
    <a href="/products?page={{nextPage}}">Siguiente ➡</a>
    {{/if}}
</div>

<script>
    async function addToCart(pid) {
        const cartId = '1234567890'; // carrito fijo para entrega

        await fetch(`/api/carts/${cartId}/products/${pid}`, {
            method: 'POST'
        });

        alert('Producto agregado al carrito');
    }
</script>